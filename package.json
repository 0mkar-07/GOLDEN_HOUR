{
  "name": "goldenhour-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @goldenhour/api --filter @goldenhour/web dev",
    "dev:api": "pnpm --filter @goldenhour/api dev",
    "dev:web": "pnpm --filter @goldenhour/web dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "migrate": "pnpm --filter @goldenhour/api migrate",
    "seed": "pnpm --filter @goldenhour/api seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
